+def _amp(device_type: str):
+    """bf16 autocast when RMP_BF16=1 (weights, optimizer and checkpoints stay fp32); no-op otherwise."""
+
+    import contextlib
+    import os
+
+    if os.environ.get("RMP_BF16") == "1":
+        return torch.autocast(device_type=device_type, dtype=torch.bfloat16)
+    return contextlib.nullcontext()
+
