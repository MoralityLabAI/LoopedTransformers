{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looped-transformers.local/schemas/vrpd_teacher_attempt_output_v1.schema.json",
  "title": "VRPD teacher attempt structured output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposed_sensor_id", "confidence"],
  "properties": {
    "proposed_sensor_id": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
